{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".loghub.json version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "developer", "description", "game", "category", "status", "cover"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "developer": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 20, "maxLength": 2000},
    "game": {"enum": ["legacy-of-goku", "legacy-of-goku-2", "buus-fury", "multiple"]},
    "category": {"enum": ["rom-hack", "fan-project", "tool", "resource"]},
    "status": {"enum": ["in-development", "released", "on-hold", "discontinued"]},
    "cover": {"type": "string", "minLength": 1, "maxLength": 500},
    "screenshots": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "asset_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "links": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 32}, "url": {"type": "string", "maxLength": 500}}}}
  }
}
