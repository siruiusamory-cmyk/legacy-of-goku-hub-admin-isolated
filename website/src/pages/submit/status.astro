---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/submit.css';
import {href, intakeAPI, submitURL, advancedSubmitURL} from '../../lib/catalog.js';
---
<Layout title="Submission status | Legacy of Goku Hub" description="Check on a project submission with your receipt."><main id="main" class="container submit-main">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={submitURL}><Icon name="back"/>Submit</a><span aria-hidden="true">/</span><span aria-current="page">Status</span></nav>
  <header class="submit-heading"><h1>Check a submission</h1><p>Paste the receipt you were given when you submitted. We keep no account or email, so the receipt is the only key.</p></header>
  {!intakeAPI && <p class="availability-note" role="note"><strong>Submissions are not open yet.</strong> There is nothing to check. The <a href={advancedSubmitURL} rel="noopener noreferrer">GitHub route</a> is available in the meantime.</p>}
  <div data-status data-api={intakeAPI}>
    <form id="status-form" class="panel submit-panel" novalidate autocomplete="off"><div class="field" data-field="receipt"><label for="f-receipt">Receipt<span class="req">Required</span></label><p class="hint" id="h-receipt">A code of 43 letters, numbers, dashes and underscores.</p><input id="f-receipt" name="receipt" type="text" spellcheck="false" autocapitalize="off" aria-describedby="h-receipt e-receipt"/><p class="error" id="e-receipt" hidden></p></div><div class="actions"><button class="button primary" type="submit">Check status<Icon name="arrow"/></button></div></form>
    <section id="saved" class="panel submit-panel" aria-labelledby="saved-title" hidden><h2 id="saved-title" class="panel-title">Submitted from this browser</h2><ul id="saved-list" class="saved-list"></ul></section>
    <section id="result" class="panel submit-panel" aria-labelledby="result-title" hidden><h2 id="result-title" class="panel-title" tabindex="-1">Status</h2><p class="status-line"><span class="status-glyph" id="status-glyph" aria-hidden="true"></span><strong id="status-name"></strong></p><p id="status-message"></p><p id="status-note" class="status-note" hidden></p><p id="status-updated" class="hint"></p><div id="status-link" hidden><a class="button primary" id="status-project" href={href('')}>View the listing<Icon name="arrow"/></a></div>
      <div id="claim-box" class="claim-steps" hidden><h3>Prove it is your project</h3><p>Add this exact text somewhere on your project page, then keep it there until a moderator confirms:</p><code id="claim-challenge"></code></div>
      <form id="revise-form" class="revise-form" novalidate hidden><h3>Send the requested details</h3><div class="field" data-field="note"><label for="r-note">Your reply</label><textarea id="r-note" name="note" rows="3" maxlength="500" aria-describedby="e-note"></textarea><p class="error" id="e-note" hidden></p></div><details class="more"><summary>Change other details</summary><div class="field" data-field="url"><label for="r-url">Project address</label><input id="r-url" name="url" type="url" inputmode="url" placeholder="https://" aria-describedby="e-url"/><p class="error" id="e-url" hidden></p></div><div class="field" data-field="title"><label for="r-title">Project name</label><input id="r-title" name="title" type="text" maxlength="100" aria-describedby="e-title"/><p class="error" id="e-title" hidden></p></div><div class="field" data-field="creator"><label for="r-creator">Creator or team</label><input id="r-creator" name="creator" type="text" maxlength="100" aria-describedby="e-creator"/><p class="error" id="e-creator" hidden></p></div><div class="field" data-field="description"><label for="r-description">Short description</label><textarea id="r-description" name="description" rows="3" maxlength="2000" aria-describedby="e-description"></textarea><p class="error" id="e-description" hidden></p></div></details><div class="actions"><button class="button primary" type="submit">Send changes<Icon name="arrow"/></button></div></form>
    </section>
    <p id="status-error" class="status-error" role="status" aria-live="polite"></p>
  </div>
</main><script>import '../../lib/status-client.js';</script></Layout>
