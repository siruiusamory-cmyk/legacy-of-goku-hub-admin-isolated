---
import Layout from '../layouts/Layout.astro';
import Badges from '../components/Badges.astro';
import Rating from '../components/Rating.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import {projectSummary} from '../lib/summary.js';
import {catalog, href, projectURL, submitURL, rating, featuredLabel, projectActions} from '../lib/catalog.js';
const featured = catalog.projects.find(p => p.featured);
const featuredAction = featured && projectActions(featured)[0];
const projects = catalog.sort.name.map(id => catalog.projects.find(p => p.id === id));
---
<Layout game={featured?.game}><main id="main">
  <section class:list={['spotlight', {'empty-spotlight': !featured}]} aria-labelledby="spotlight-title"><div class="spotlight-inner"><PortraitFrame/>
    {featured ? <><a class="spotlight-art" href={projectURL(featured)} tabindex="-1" aria-hidden="true"><ProjectArtwork src={href(featured.cover)} loading="eager" fetchpriority="high"/></a><div class="spotlight-copy"><span class="featured-label">★ &nbsp; {featuredLabel(featured)}</span><h1 id="spotlight-title">{featured.title}</h1><Badges project={featured}/><p class="spotlight-description">{projectSummary(featured.description)}</p><Rating {...rating(featured)} projectId={featured.id}/><div class="hero-actions"><a class="button primary" href={projectURL(featured)}><Icon name="play"/>View Project</a>{featuredAction && <a class="button secondary" href={featuredAction.url} rel="noopener noreferrer"><Icon name={featuredAction.id === 'repository' ? 'github' : featuredAction.icon}/>{featuredAction.label}</a>}</div></div></> : <><div class="empty-art" aria-hidden="true"><span class="empty-orbit"></span><span class="empty-art-title">Your next<br/><em>adventure awaits.</em></span><span class="empty-art-caption">Legacy of Goku · LoG II · Buu’s Fury</span></div><div class="spotlight-copy"><span class="featured-label">★ &nbsp; Community projects</span><h1 id="spotlight-title">A new home for<br/>the next adventure.</h1><p class="spotlight-description">{catalog.projects.length ? "Browse community ROM hacks, fan projects and tools for the Legacy of Goku series. Find your next adventure in the directory below." : "Discover ROM hacks, fan projects and tools for the Legacy of Goku series. Our first community projects are on their way."}</p><p class="quiet">Building something? Give your project a place in the spotlight.</p><div class="hero-actions"><a class="button primary" href={submitURL}><Icon name="code"/>Submit a project</a><a class="button secondary" href="#directory">Explore the directory<Icon name="arrow"/></a></div></div></>}
  </div></section>
  <section id="directory" class="directory container" aria-labelledby="directory-title"><div class="directory-heading"><h2 id="directory-title">Project Directory</h2><p>ROM hacks, enhancements, and tools for the Legacy of Goku series.</p></div>
  <form class="directory-controls" role="search" aria-label="Find projects"><div class="search-field"><Icon name="search"/><label class="sr-only" for="search">Search projects</label><input id="search" name="q" type="search" placeholder="Search projects…" autocomplete="off"/></div><div class="filter-controls"><button type="button" id="reset-filters" class="filter-chip selected" aria-label="Show all projects and reset filters">All</button><label><span class="sr-only">Base game</span><select aria-label="Base game" id="game" name="game"><option value="">All games</option><option value="legacy-of-goku">LoG 1</option><option value="legacy-of-goku-2">LoG II</option><option value="buus-fury">Buu’s Fury</option><option value="multiple">Multiple games</option></select></label><label><span class="sr-only">Project category</span><select aria-label="Project category" id="category" name="category"><option value="">All categories</option><option value="rom-hack">ROM Hacks</option><option value="fan-project">Fan Projects</option><option value="tool">Tools</option><option value="resource">Resources</option></select></label><label><span class="sr-only">Development status</span><select aria-label="Development status" id="status" name="status"><option value="">All statuses</option><option value="released">Released</option><option value="in-development">In Development</option><option value="on-hold">On Hold</option><option value="discontinued">Discontinued</option></select></label></div><label class="sort-label"><span class="sr-only">Sort projects</span><select aria-label="Sort projects" id="sort" name="sort"><option value="name">Sort by: Name</option><option value="release">Sort by: Release date</option><option value="updated">Sort by: Last updated</option></select></label></form>
  <p id="result-count" class="sr-only" role="status" aria-live="polite">{projects.length} projects</p><div class="project-grid">{projects.map(project => <ProjectCard project={project}/>)}</div>
  <div id="no-results" class="empty-directory" hidden={projects.length > 0}><span class="empty-symbol" aria-hidden="true">✦</span><h3>{projects.length ? 'No matching projects' : 'The adventure starts here.'}</h3><p>{projects.length ? 'Try another search or clear your filters.' : 'No approved projects yet. Check back soon, or be part of the first wave.'}</p>{projects.length ? <button class="button secondary" type="button" data-clear-filters>Clear filters</button> : <a class="button primary" href={submitURL}>Submit your project<Icon name="arrow"/></a>}</div>
  <noscript><p class="quiet">All projects are shown. Enable JavaScript to search, filter and sort.</p></noscript></section>
</main><script src="../lib/directory.js"/></Layout>
